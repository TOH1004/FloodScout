CAMERA_INDEX=0

# HOG + SVM detection threshold.
# This is a raw SVM decision margin weight — NOT a YOLO confidence percentage.
# Typical range: 0.0 (most sensitive) to 1.5 (strict, fewer false positives).
# Default 0.0 means any detection at the SVM decision boundary is accepted.
HOG_DETECTION_THRESHOLD=0.0

ALERT_COOLDOWN=3.0
DETECTION_COOLDOWN=5.0
CLEAR_HOLD_SECONDS=3.0
BACKEND_PORT=8000
VISION_API_KEY=
VISION_MODEL=gemini-3.6-flash
CAPTURES_DIR=captures
XIAO_SERIAL_PORT=COM4
XIAO_SERIAL_BAUD=115200

# Pan & Tilt Action Sonar / SG90 Servo Actuator Settings
# Mode: "esp32" (Wi-Fi HTTP direct to ESP32 WebServer) or "mock" (software simulation)
PAN_TILT_MODE=esp32
# Base URL for ESP32 controller (e.g. http://10.185.112.106)
ESP32_BASE_URL=http://10.185.112.106
# Servo rotation step in degrees per button press (default: 5, range: 0-180)
SERVO_STEP=5
